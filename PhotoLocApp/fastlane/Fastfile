# Fastfile for PhotoLoc iOS App
# Documentation: https://docs.fastlane.tools/

default_platform(:ios)

platform :ios do
  # Variables
  SCHEME = "PhotoLocApp"
  BUNDLE_ID = "com.yourname.PhotoLocApp"  # Update with your bundle ID

  before_all do
    ensure_git_status_clean unless ENV['SKIP_GIT_CHECK']
  end

  # =====================================
  # BUILD LANES
  # =====================================

  desc "Build app for testing"
  lane :build do
    build_app(
      scheme: SCHEME,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      skip_archive: true,
      skip_codesigning: true
    )
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      scheme: SCHEME,
      devices: ["iPhone 14"],
      clean: true
    )
  end

  # =====================================
  # TESTFLIGHT LANES
  # =====================================

  desc "Deploy to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "PhotoLocApp.xcodeproj"
    )

    # Build app
    build_app(
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          BUNDLE_ID => ENV["PROVISIONING_PROFILE_NAME"]
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key_path: "fastlane/app_store_connect_api_key.json",
      skip_waiting_for_build_processing: false,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false
    )

    # Clean build artifacts
    clean_build_artifacts
  end

  desc "Deploy to TestFlight with external testing"
  lane :beta_external do
    beta

    # Distribute to external testers after processing
    upload_to_testflight(
      api_key_path: "fastlane/app_store_connect_api_key.json",
      skip_waiting_for_build_processing: true,
      distribute_external: true,
      notify_external_testers: true,
      groups: ["Public Beta"],
      changelog: "Bug fixes and improvements"
    )
  end

  # =====================================
  # APP STORE LANES
  # =====================================

  desc "Deploy to App Store"
  lane :release do
    # Increment version
    if ENV['VERSION']
      increment_version_number(
        version_number: ENV['VERSION'],
        xcodeproj: "PhotoLocApp.xcodeproj"
      )
    end

    # Increment build number
    increment_build_number(
      build_number: latest_testflight_build_number + 1,
      xcodeproj: "PhotoLocApp.xcodeproj"
    )

    # Build app
    build_app(
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to App Store Connect
    upload_to_app_store(
      api_key_path: "fastlane/app_store_connect_api_key.json",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false
    )

    # Clean build artifacts
    clean_build_artifacts
  end

  desc "Submit app for review"
  lane :submit do
    upload_to_app_store(
      api_key_path: "fastlane/app_store_connect_api_key.json",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  # =====================================
  # UTILITY LANES
  # =====================================

  desc "Download certificates and provisioning profiles"
  lane :sync_certs do
    match(
      type: "appstore",
      readonly: true,
      app_identifier: BUNDLE_ID
    )
  end

  desc "Register new device"
  lane :register_device do |options|
    device_name = options[:name]
    udid = options[:udid]

    register_devices(
      devices: {
        device_name => udid
      }
    )

    match(type: "development", force_for_new_devices: true)
  end

  desc "Capture screenshots"
  lane :screenshots do
    snapshot
  end

  desc "Update metadata"
  lane :update_metadata do
    deliver(
      api_key_path: "fastlane/app_store_connect_api_key.json",
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true
    )
  end

  # =====================================
  # ERROR HANDLING
  # =====================================

  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception.message}")

    # Send notification (optional - requires setup)
    # slack(
    #   message: "Build failed in lane #{lane}",
    #   success: false
    # )
  end

  after_all do |lane|
    UI.success("✅ Successfully completed lane: #{lane}")

    # Send success notification (optional)
    # slack(
    #   message: "Successfully completed #{lane}",
    #   success: true
    # )
  end
end
